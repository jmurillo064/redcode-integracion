          "401": {
            "description": "No authorizado"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "Introduce el token JWT obtenido desde Keycloak",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
